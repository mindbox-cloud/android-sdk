<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application>
        <!-- Read by the React Native SDK, and by the core SDK when App Startup does not run; otherwise the initializer below registers the service. -->
        <meta-data
            android:name="cloud.mindbox.push.provider.firebase"
            android:value="cloud.mindbox.mindbox_firebase.MindboxFirebase" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="cloud.mindbox.mindbox_firebase.MindboxFirebaseInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
