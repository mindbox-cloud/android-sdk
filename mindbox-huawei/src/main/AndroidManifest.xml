<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Read by the React Native SDK to find push providers; the native SDK uses the initializer below. -->
        <meta-data
            android:name="cloud.mindbox.push.provider.huawei"
            android:value="cloud.mindbox.mindbox_huawei.MindboxHuawei" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="cloud.mindbox.mindbox_huawei.MindboxHuaweiInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>
</manifest>
